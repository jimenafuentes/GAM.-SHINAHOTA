# Copiar a .env en el VPS (junto a docker-compose.yml) y completar.
# El .env nunca se sube al repositorio.

DOMINIO=gamshinahota.rusoft.dev
# Puerto local donde escucha el frontend; el Nginx del VPS hace proxy hacia él
PUERTO_WEB=8095

# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DB_NAME=sistema_weg
DB_USER=postgres
# Contraseña nueva y larga (la de desarrollo, 12345, quedó publicada en el repo)
DB_PASSWORD=

# Dirección del contrato en Ganache. Con el mnemónico de Hardhat siempre es esta.
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

GUNICORN_WORKERS=3
